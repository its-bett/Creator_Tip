# -----------------------------------------------------------------------------
# Supabase (optional in local development)
# Leave these unset to use the built-in file-backed demo store at .data/store.json
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which seeded creator the site root should show
DEFAULT_CREATOR_USERNAME=1._coastspoter

# Optional override for the local demo store location
# LOCAL_STORE_PATH=/path/to/store.json

# -----------------------------------------------------------------------------
# Creator dashboard (private earnings)
# The access code creators enter at /dashboard/[username]. Generate a long random
# string, e.g. `openssl rand -hex 32`. In local development, if this is unset,
# the temporary code `tipjar-demo` is accepted. Production has no fallback:
# the dashboard stays locked until this is set.
# -----------------------------------------------------------------------------
CREATOR_DASHBOARD_TOKEN=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# Safaricom Daraja — M-Pesa STK Push
# Leave unset to run in demo mode (no real payments, with a simulation button)
# Sandbox: https://sandbox.safaricom.co.ke
# Live:    https://api.safaricom.co.ke
# -----------------------------------------------------------------------------
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Public URL Safaricom can reach. Required for real callbacks (localhost will not work).
# MPESA_CALLBACK_URL=https://your-domain.example/api/tips/callback

# Secret appended to callback URL as ?secret=... (recommended).
# MPESA_CALLBACK_SECRET=replace-with-a-long-random-string

# How long to wait for an STK response before marking a tip as failed (minutes)
PAYMENT_TIMEOUT_MINUTES=10
